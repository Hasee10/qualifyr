# Copy to .env.local and fill in. Never commit .env.local.
# Base URL of the FastAPI backend (gtm_engine.api.main:app).
# - Local dev: point at a standalone `uvicorn gtm_engine.api.main:app` (unprefixed routes).
# - Deployed on Vercel: the backend runs as this same project's Python function at
#   /api (see web/api/index.py + web/vercel.json), so use this deployment's own
#   origin + "/api", e.g. https://your-app.vercel.app/api.
NEXT_PUBLIC_API_URL=http://localhost:8000
