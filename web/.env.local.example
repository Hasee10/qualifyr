# Copy to .env.local and fill in. Never commit .env.local.
# Base URL of the FastAPI backend (gtm_engine.api.main:app). Defaults to
# http://localhost:8000 if unset — fine for local dev, must be set to the
# backend's public URL for any deployed environment (e.g. Vercel).
NEXT_PUBLIC_API_URL=http://localhost:8000
