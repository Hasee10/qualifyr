# Copy to .env and fill in. Never commit .env.
# Only production-required variables are listed here.
# For the full reference (mailbox rotation, LLM, Sheets, daily limits, etc.)
# see docs/API_KEYS.md.

# --- Database (Postgres/Supabase) --- REQUIRED
GTM_DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# --- Authentication (Supabase Auth) --- REQUIRED
GTM_SUPABASE_URL=https://your-project.supabase.co

# --- Encryption (per-user API key storage) --- REQUIRED
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GTM_ENCRYPTION_KEY=

# --- Frontend (Vercel env vars, baked in at BUILD time) --- REQUIRED
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Email sending (at least one method needed for real sends) ---
GTM_SMTP_USER=
GTM_SMTP_PASSWORD=

# --- Google Places enrichment ---
GTM_GOOGLE_PLACES_API_KEY=

# --- Website finder (at least one recommended) ---
GTM_BRAVE_API_KEY=

# --- GitHub Actions dispatch (Vercel only: triggers long-running workflows) ---
# GTM_GITHUB_TOKEN=
# GTM_GITHUB_REPO=owner/repo
