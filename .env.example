# Copy to .env and fill in. Never commit .env.
# Full descriptions: docs/API_KEYS.md. Everything below is optional except one
# way to send mail (GTM_SMTP_* or GTM_GMAIL_* on mailbox #1) if you want real sends.

# --- Mailbox #1 (Gmail) — sending + IMAP reply sync ---
GTM_SMTP_USER=
GTM_SMTP_PASSWORD=
# Preferred over the App Password above: OAuth2 (XOAUTH2). Run `gtm outreach gmail-auth`
# once it's set up, or fill these in directly.
GTM_GMAIL_CLIENT_ID=
GTM_GMAIL_CLIENT_SECRET=
GTM_GMAIL_REFRESH_TOKEN=

# --- Additional mailboxes for rotation (slots 2-10) ---
# GTM_MAILBOX_2_USER=
# GTM_MAILBOX_2_PASSWORD=
# GTM_MAILBOX_2_CLIENT_ID=
# GTM_MAILBOX_2_CLIENT_SECRET=
# GTM_MAILBOX_2_REFRESH_TOKEN=
# GTM_MAILBOX_2_LIMIT=
# GTM_MAILBOX_2_NAME=

# --- Email verification (decision-maker mailbox confirmation) ---
GTM_REACHER_URL=
GTM_HUNTER_API_KEY=

# --- Website finder ---
GTM_BRAVE_API_KEY=
GTM_GOOGLE_CSE_KEY=
GTM_GOOGLE_CSE_ID=

# --- Optional LLM layer (off by default; enable_llm: true in campaign config) ---
GTM_GROQ_API_KEY=
GTM_GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434

# --- Google Sheets export mirror ---
GTM_SHEETS_SPREADSHEET_ID=
GTM_SHEETS_CREDENTIALS_JSON=

# --- Engine overrides (config/engine.yaml settings) ---
# GTM_DB_PATH=
# GTM_CONCURRENCY=
