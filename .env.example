# Copy to .env and fill in. Never commit .env.
# Full descriptions: docs/API_KEYS.md. Everything below is optional except one
# way to send mail (GTM_SMTP_* or GTM_GMAIL_* on mailbox #1) if you want real sends.

# --- Mailbox #1 (Gmail) — sending + IMAP reply sync ---
GTM_SMTP_USER=
GTM_SMTP_PASSWORD=
# Preferred over the App Password above: OAuth2 (XOAUTH2). Run `gtm outreach gmail-auth`
# once it's set up, or fill these in directly.
GTM_GMAIL_CLIENT_ID=
GTM_GMAIL_CLIENT_SECRET=
GTM_GMAIL_REFRESH_TOKEN=

# --- Additional mailboxes for rotation (slots 2-10) ---
# GTM_MAILBOX_2_USER=
# GTM_MAILBOX_2_PASSWORD=
# GTM_MAILBOX_2_CLIENT_ID=
# GTM_MAILBOX_2_CLIENT_SECRET=
# GTM_MAILBOX_2_REFRESH_TOKEN=
# GTM_MAILBOX_2_LIMIT=
# GTM_MAILBOX_2_NAME=

# --- Email verification (decision-maker mailbox confirmation) ---
GTM_REACHER_URL=
GTM_HUNTER_API_KEY=

# --- Website finder ---
GTM_BRAVE_API_KEY=
GTM_GOOGLE_CSE_KEY=
GTM_GOOGLE_CSE_ID=

# --- Optional LLM layer (off by default; enable_llm: true in campaign config) ---
GTM_GROQ_API_KEY=
GTM_GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434

# --- Google Sheets export mirror ---
GTM_SHEETS_SPREADSHEET_ID=
GTM_SHEETS_CREDENTIALS_JSON=

# --- Database (Postgres/Supabase) ---
# Required in any deployed environment. Use Supabase's pooler connection string
# (Project Settings -> Database -> Connection string -> Transaction pooler mode)
# with the database password filled in. Local `gtm` CLI use also requires this now
# (storage moved off local SQLite).
GTM_DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# The DB-backed tests create and drop a throwaway schema per test. Point this at a
# separate Supabase project if you have one; it falls back to GTM_DATABASE_URL, which
# means the suite would run its DDL against production data.
# GTM_TEST_DATABASE_URL=

# --- Engine overrides (config/engine.yaml settings) ---
# GTM_CONCURRENCY=

# --- API server ---
# Comma-separated extra allowed origins for the FastAPI CORS policy, e.g. your
# deployed frontend URL. localhost:3000 is always allowed.
# GTM_CORS_ORIGINS=https://your-app.vercel.app

# --- GitHub Actions dispatch (long-running campaign runs / outreach sends) ---
# Only needed where the API runs (Vercel): triggers gather-leads.yml / outreach.yml
# instead of running them in-request, since both can take minutes-to-hours.
# GTM_GITHUB_TOKEN=   # repo-scoped PAT or fine-grained token with actions:write
# GTM_GITHUB_REPO=owner/repo
# GTM_GITHUB_REF=main
